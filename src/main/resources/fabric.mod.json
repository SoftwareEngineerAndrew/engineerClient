{
  "schemaVersion": 1,
  "id": "engineerclient",
  "version": "${version}",
  "name": "Engineer Client",
  "description": "Andrew's Odin addon: blood-rush waypoint profiles, M7 phase-3 role rotation, leap-menu POV previews and Party Finder stats.",
  "authors": ["Andrew"],
  "license": "All-Rights-Reserved",
  "environment": "client",
  "mixins": ["engineerclient.mixins.json"],
  "entrypoints": {
    "client": [
      { "adapter": "kotlin", "value": "com.engineerclient.EngineerClient" }
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": ">=0.151.0",
    "fabric-language-kotlin": ">=1.13.12+kotlin.2.4.0",
    "minecraft": "~26.1",
    "odin": ">=0.3.1"
  }
}
