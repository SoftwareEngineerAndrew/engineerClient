{
  "schemaVersion": 1,
  "id": "engineerclient",
  "version": "${version}",
  "name": "Engineer Client",
  "description": "An Odin addon for Hypixel SkyBlock dungeons: M7 phase-3 role rotation, leap-menu POV previews, the P3 Sim and Party Finder stats.",
  "authors": ["engineerandrew"],
  "license": "All-Rights-Reserved",
  "environment": "client",
  "breaks": { "coffeeclient": "*", "devgineerclient": "*" },
  "mixins": ["engineerclient.mixins.json", "engineerclient.odin.mixins.json", "engineerclient.devonian.mixins.json", "coffeeclient.mixins.json", "coffeeclient.odin.mixins.json", "devgineerclient.mixins.json"],
  "entrypoints": {
    "client": [
      { "adapter": "kotlin", "value": "com.engineerclient.EngineerClient" },
      { "adapter": "kotlin", "value": "com.coffeeclient.CoffeeClient" },
      { "adapter": "kotlin", "value": "com.devgineerclient.DevgineerClient" }
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": ">=0.151.0",
    "fabric-language-kotlin": ">=1.13.12+kotlin.2.4.0",
    "minecraft": "~26.1.2",
    "odin": ">=0.3.6"
  }
}
