{
  "schemaVersion": 1,
  "id": "engineerclient",
  "version": "${version}",
  "name": "Engineer Client",
  "description": "A Hypixel SkyBlock dungeons mod: M7 phase-3 role rotation, leap-menu POV previews, ADS (Advanced Dungeon Simulator) and Party Finder stats.",
  "authors": ["engineerandrew"],
  "license": "All-Rights-Reserved",
  "environment": "client",
  "breaks": { "devgineerclient": "*" },
  "accessWidener": "adm.accesswidener",
  "mixins": ["adm.mixins.json", "engineerclient.mixins.json", "engineerclient.core.mixins.json", "engineerclient.sodium.mixins.json", "devgineerclient.mixins.json", "devgineerclient.core.mixins.json"],
  "entrypoints": {
    "modmenu": ["com.adm.clickgui.ModMenuIntegration"],
    "client": [
      { "adapter": "kotlin", "value": "com.adm.AdmMod" },
      { "adapter": "kotlin", "value": "com.engineerclient.EngineerClient" },
      { "adapter": "kotlin", "value": "com.devgineerclient.DevgineerClient" }
    ]
  },
  "custom": {
    "badoptimizations:cache_hooks": { "lightmap": "com.engineerclient.render.FullbrightLightmapHook" }
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": ">=0.161.0",
    "fabric-language-kotlin": ">=1.14.1+kotlin.2.4.20",
    "minecraft": "~26.3"
  }
}
