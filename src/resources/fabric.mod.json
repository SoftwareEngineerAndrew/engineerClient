{
  "schemaVersion": 1,
  "id": "engineerclient",
  "version": "${version}",
  "name": "ADS",
  "description": "Hypixel SkyBlock dungeons: ADS (Advanced Dungeon Simulator), which runs on its own, and with Odin installed M7 phase-3 role rotation, leap-menu POV previews and Party Finder stats.",
  "authors": ["engineerandrew"],
  "license": "All-Rights-Reserved",
  "icon": "assets/engineerclient/icon.png",
  "environment": "client",
  "breaks": { "coffeeclient": "*", "devgineerclient": "*" },
  "mixins": ["engineerclient.mixins.json", "rustclear.mixins.json","engineerclient.odin.mixins.json", "engineerclient.devonian.mixins.json", "coffeeclient.mixins.json", "coffeeclient.odin.mixins.json", "devgineerclient.mixins.json", "devgineerclient.odin.mixins.json"],
  "entrypoints": {
    "preLaunch": ["net.rustclear.mod.online.E4mcPreLaunch"],
    "client": [
      "net.rustclear.mod.RustclearMod",
      "net.rustclear.mod.engine.Engine",
      { "adapter": "kotlin", "value": "com.engineerclient.EngineerClient" },
      "com.coffeeclient.CoffeeEntry",
      "com.devgineerclient.DevgineerEntry"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": ">=0.161.0",
    "fabric-language-kotlin": ">=1.14.1+kotlin.2.4.20",
    "minecraft": "~26.3",
    "java": ">=25"
  },
  "recommends": {
    "odin": ">=0.3.7"
  },
  "suggests": {
    "e4mc": "*"
  }
}
