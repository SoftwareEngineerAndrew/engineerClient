{
  "schemaVersion": 1,
  "id": "engineerclient",
  "version": "${version}",
  "name": "Engineer Client",
  "description": "engineerandrew's Odin addon: M7 phase-3 role rotation, leap-menu POV previews, the P3 Sim and Party Finder stats.",
  "authors": ["engineerandrew"],
  "license": "All-Rights-Reserved",
  "environment": "client",
  "mixins": ["engineerclient.mixins.json", "engineerclient.odin.mixins.json"],
  "entrypoints": {
    "client": [
      { "adapter": "kotlin", "value": "com.engineerclient.EngineerClient" }
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": ">=0.161.0",
    "fabric-language-kotlin": ">=1.14.1+kotlin.2.4.20",
    "minecraft": "~26.2",
    "odin": ">=0.3.6"
  }
}
